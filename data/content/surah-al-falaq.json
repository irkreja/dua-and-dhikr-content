          {
            "ar": "الرَّحْمٰنِ",
            "bn": "পরম করুণাময়"
          },
          {
            "ar": "الرَّحِیْمِ",
            "bn": "অসীম দয়ালু"
          },
          {
            "ar": "۟",
            "bn": ""
          }
        ]
      },
      {
        "id": 2,
        "text": "",
        "translation": "বলুন, ‘আমি আশ্রয় প্রার্থনা করছি ঊষার রবের",
        "showDivider": true,
        "words": [
          {
            "ar": "قُلْ",
            "bn": "বলো"
          },
          {
            "ar": "اَعُوْذُ",
            "bn": "\"আমি আশ্রয় চাই"
          },
          {
            "ar": "بِرَبِّ",
            "bn": "স্রষ্টার নিকট"
          },
          {
            "ar": "الْفَلَقِ",
            "bn": "প্রভাতের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(১)"
          }
        ]
      },
      {
        "id": 3,
        "text": "",
        "translation": "তিনি যা সৃষ্টি করেছেন তার অনিষ্ট হতে,",
        "showDivider": true,
        "words": [
          {
            "ar": "مِنْ",
            "bn": "হতে"
          },
          {
            "ar": "شَرِّ",
            "bn": "অনিষ্ট"
          },
          {
            "ar": "مَا",
            "bn": "যা"
          },
          {
            "ar": "خَلَقَ",
            "bn": "তিনি সৃষ্টি করেছেন"
          },
          {
            "ar": "۟ۙ",
            "bn": "(২)"
          }
        ]
      },
      {
        "id": 4,
        "text": "",
        "translation": "আর অনিষ্ট হতে রাতের অন্ধকারের, যখন তা গভীর হয়",
        "showDivider": true,
        "words": [
          {
            "ar": "وَمِنْ",
            "bn": "এবং হতে"
          },
          {
            "ar": "شَرِّ",
            "bn": "অনিষ্ট"
          },
          {
            "ar": "غَاسِقٍ",
            "bn": "রাতের অন্ধকারের"
          },
          {
            "ar": "اِذَا",
            "bn": "যখন"
          },
          {
            "ar": "وَقَبَ",
            "bn": "তা গভীর হয়"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৩)"
          }
        ]
      },
      {
        "id": 5,
        "text": "",
        "translation": "আর অনিষ্ট হতে সমস্ত নারীদের, যারা গিরায় ফুঁক দেয়,",
        "showDivider": true,
        "words": [
          {
            "ar": "وَمِنْ",
            "bn": "এবং হতে"
          },
          {
            "ar": "شَرِّ",
            "bn": "অনিষ্ট"
          },
          {
            "ar": "النَّفّٰثٰتِ",
            "bn": "ফুঁকদানকারীর (রাতের) অনিষ্ট"
          },
          {
            "ar": "فِی",
            "bn": "মধ্যে"
          },
          {
            "ar": "الْعُقَدِ",
            "bn": "গিঁটগুলোর"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৪)"
          }
        ]
      },
      {
        "id": 6,
        "text": "",
        "translation": "আর অনিষ্ট হতে হিংসুকের, যখন সে হিংসা করে।’",
        "showDivider": true,
        "words": [
          {
            "ar": "وَمِنْ",
            "bn": "এবং হতে"
          },
          {
            "ar": "شَرِّ",
            "bn": "অনিষ্ট"
          },
          {
            "ar": "حَاسِدٍ",
            "bn": "হিংসুকের"
          },
          {
            "ar": "اِذَا",
            "bn": "যখন"
          },
          {
            "ar": "حَسَدَ",
            "bn": "সে হিংসা করে\""
          },
          {
            "ar": "۟۠",
            "bn": "(৫)"
          }
        ]
