  "content": {
    "items": [
      {
        "id": 1,
        "text": "اللَّهُمَّ إِنَّكَ قُلْتَ، ادْعُونِي أَسْتَجِبْ لَكُمْ،",
        "pronunciation": "আল্লা-হুম্মা ইন্নাকা ক্বুলতা, উদ‘ঊনী আস্তাজিব লাকুম,",
        "translation": "হে আল্লাহ! নিশ্চয়ই আপনি বলেছেন, ‘তোমরা আমাকে ডাকো, আমি তোমাদের ডাকে সাড়া দেব।’",
        "showDivider": false,
        "words": [
          {
            "ar": "اللَّهُمَّ",
            "bn": "হে আল্লাহ"
          },
          {
            "ar": "إِنَّكَ",
            "bn": "নিশ্চয়ই আপনি"
          },
          {
            "ar": "قُلْتَ،",
            "bn": "বলেছেন"
          },
          {
            "ar": "ادْعُونِي",
            "bn": "তোমরা আমাকে ডাকো"
          },
          {
            "ar": "أَسْتَجِبْ",
            "bn": "আমি সাড়া দেব"
          },
          {
            "ar": "لَكُمْ،",
            "bn": "তোমাদের জন্য"
          }
        ]
      },
      {
        "id": 2,
        "text": "وَالْحَقَّ أَقُولُ،",
        "pronunciation": "ওয়াল হাক্বক্বা আক্বূলু,",
        "translation": "এবং (আপনি আরও বলেছেন,) ‘আমি সত্য কথাই বলছি।’",
        "showDivider": false,
        "words": [
          {
            "ar": "وَالْحَقَّ",
            "bn": "এবং সত্য কথাই"
          },
          {
            "ar": "أَقُولُ،",
            "bn": "আমি বলি"
          }
        ]
      },
      {
        "id": 3,
        "text": "وَعْدَ اللَّهِ حَقًّا،",
        "pronunciation": "ওয়া‘দাল্লা-হি হাক্বক্বা-,",
        "translation": "‘আল্লাহর ওয়াদা সত্য’",
        "showDivider": false,
        "words": [
          {
            "ar": "وَعْدَ",
            "bn": "ওয়াদা বা অঙ্গীকার"
          },
          {
            "ar": "اللَّهِ",
            "bn": "আল্লাহর"
          },
          {
            "ar": "حَقًّا،",
            "bn": "সত্য"
          }
        ]
      },
      {
        "id": 4,
        "text": "وَمَنْ أَصْدَقُ مِنَ اللَّهِ قِيلًا،",
        "pronunciation": "ওয়া মান আসদাক্বু মিনাল্লা-হি ক্বীলা-,",
        "translation": "এবং ‘কথায় আল্লাহর চেয়ে অধিক সত্যবাদী আর কে আছে?’",
        "showDivider": false,
        "words": [
          {
            "ar": "وَمَنْ",
            "bn": "এবং কে"
          },
          {
            "ar": "أَصْدَقُ",
            "bn": "অধিক সত্যবাদী"
          },
          {
            "ar": "مِنَ",
            "bn": "চেয়ে বা হতে"
          },
          {
            "ar": "اللَّهِ",
            "bn": "আল্লাহর"
          },
          {
            "ar": "قِيلًا،",
            "bn": "কথায়"
          }
        ]
      },
      {
        "id": 5,
        "text": "رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَى رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ،",
        "pronunciation": "রব্বানা- ওয়া আ-তিনা- মা- ওয়া‘আত্তানা- ‘আলা- রুসুলিকা ওয়া লা- তুখযিনা- ইয়াওমাল ক্বিয়া-মাহ,",
        "translation": "হে আমাদের রব! আপনি আপনার রাসূলগণের মাধ্যমে আমাদের যে ওয়াদা দিয়েছেন, তা আমাদের দান করুন এবং কিয়ামতের দিন আমাদের লাঞ্ছিত করবেন না।",
        "showDivider": false,
        "words": [
          {
            "ar": "رَبَّنَا",
            "bn": "হে আমাদের রব"
          },
          {
            "ar": "وَآتِنَا",
            "bn": "এবং আমাদের দান করুন"
          },
          {
            "ar": "مَا",
            "bn": "যা"
          },
          {
            "ar": "وَعَدْتَنَا",
            "bn": "আপনি আমাদের ওয়াদা দিয়েছেন"
          },
          {
            "ar": "عَلَى",
            "bn": "মাধ্যমে (উপর)"
          },
          {
            "ar": "رُسُلِكَ",
            "bn": "আপনার রাসূলগণের"
          },
          {
