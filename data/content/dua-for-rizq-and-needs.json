  "content": {
    "items": [
      {
        "id": 1,
        "text": "يَا ذَا ٱلْجَلَالِ وَٱلْإِكْرَامِ",
        "translation": "হে মহিমাময় ও মহানুভব! অথবা, হে মহিমা ও সম্মানের অধিকারী!",
        "showDivider": true,
        "words": [
          {
            "ar": "يَا",
            "bn": "হে"
          },
          {
            "ar": "ذَا",
            "bn": "অধিকারী"
          },
          {
            "ar": "ٱلْجَلَالِ",
            "bn": "মহিমার"
          },
          {
            "ar": "وَٱلْإِكْرَامِ",
            "bn": "ও সম্মানের / মহানুভবতার"
          }
        ]
      },
      {
        "id": 2,
        "text": "ٱللَّٰهُمَّ إِنِّيْ أَسْأَلُكَ عِلْمًا نَافِعًا، وَرِزْقًا طَيِّبًا، وَعَمَلًا مُتَقَبَّلًا.",
        "translation": "হে আল্লাহ! আমি আপনার কাছে চাই উপকারী জ্ঞান, পবিত্র (হালাল ও উত্তম) রিজিক এবং কবুলযোগ্য আমল।",
        "showDivider": true,
        "words": [
          { "ar": "ٱللَّٰهُمَّ", "bn": "হে আল্লাহ" },
          { "ar": "إِنِّيْ", "bn": "নিশ্চয়ই আমি" },
          { "ar": "أَسْأَلُكَ", "bn": "আপনার কাছে চাই" },
          { "ar": "عِلْمًا", "bn": "জ্ঞান" },
          { "ar": "نَافِعًا،", "bn": "উপকারী" },
          { "ar": "وَرِزْقًا", "bn": "এবং রিযক" },
          { "ar": "طَيِّبًا،", "bn": "পবিত্র (হালাল ও উত্তম)" },
          { "ar": "وَعَمَلًا", "bn": "এবং আমল" },
          { "ar": "مُتَقَبَّلًا.", "bn": "কবুলকৃত" }
        ]
      },
      {
        "id": 3,
        "text": "ٱللَّٰهُمَّ ٱكْفِنِيْ بِحَلَالِكَ عَنْ حَرَامِكَ وَأَغْنِنِيْ بِفَضْلِكَ عَمَّنْ سِوَاكَ",
        "translation": "হে আল্লাহ! আপনার হালালের মাধ্যমে আমার প্রয়োজন পূরণ করে দিন, যাতে আপনার হারাম থেকে বেঁচে থাকতে পারি। আর আপনার অনুগ্রহ দিয়ে আমাকে আপনি ছাড়া অন্য সবার থেকে অমুখাপেক্ষী করে দিন।",
        "showDivider": true,
        "words": [
          {
            "ar": "ٱللَّٰهُمَّ",
            "bn": "হে আল্লাহ"
          },
          {
            "ar": "ٱكْفِنِيْ",
            "bn": "আমাকে যথেষ্ট করে দিন"
          },
          {
            "ar": "بِحَلَالِكَ",
            "bn": "আপনার হালাল দ্বারা"
