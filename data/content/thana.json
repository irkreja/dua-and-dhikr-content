          { "ar": "اللّٰهُمَّ", "bn": "হে আল্লাহ" },
          { "ar": "وَبِحَمْدِكَ،", "bn": "এবং আপনার প্রশংসাসহ" },
          { "ar": "وَتَبَارَكَ", "bn": "এবং বরকতময়" },
          { "ar": "اسْمُكَ،", "bn": "আপনার নাম" },
