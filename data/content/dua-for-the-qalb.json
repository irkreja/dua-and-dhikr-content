  "content": {
    "items": [
      {
        "id": 1,
        "text": "يَاْ مُقَلِّبَ ٱلْقُلُوْبِ ثَبِّتْ قَلْبِيْ عَلَىٰ دِيْنِكَ",
        "translation": "হে অন্তরসমূহের পরিবর্তনকারী! আমার অন্তরকে আপনার দ্বীনের উপর দৃঢ় (অবিচল) রাখুন। (তিরমিযী: ২১৪০, ইবনে মাজাহ: ৩৮৩৪)",
        "words": [
          { "ar": "يَاْ", "bn": "হে" },
          { "ar": "مُقَلِّبَ", "bn": "পরিবর্তনকারী" },
          { "ar": "ٱلْقُلُوْبِ", "bn": "অন্তরসমূহের" },
          { "ar": "ثَبِّتْ", "bn": "অবিচল / দৃঢ় রাখুন" },
          { "ar": "قَلْبِيْ", "bn": "আমার অন্তরকে" },
          { "ar": "عَلَىٰ", "bn": "ওপর" },
          { "ar": "دِيْنِكَ.", "bn": "আপনার দ্বীনের" }
        ]
      },
      {
        "id": 2,
        "text": "ٱللَّٰهُمَّ، إِنِّيْ أَعُوْذُ بِكَ مِنَ ٱلْعَجْزِ، وَٱلْكَسَلِ، وَٱلْبُخْلِ، وَٱلْجُبْنِ، وَٱلْهَرَمِ، وَعَذَاْبِ ٱلْقَبْرِ.",
        "translation": "হে আল্লাহ! নিশ্চয় আমি আপনার কাছে অক্ষমতা, অলসতা, কৃপণতা, কাপুরুষতা, অতি বার্ধক্য এবং কবরের শাস্তি থেকে আশ্রয় চাই। (আন-নাসায়ী: ৫৫৩৭; মুসলিম: ২৭২২)",
        "words": [
          { "ar": "ٱللَّٰهُمَّ،", "bn": "হে আল্লাহ" },
          { "ar": "إِنِّيْ", "bn": "নিশ্চয় আমি" },
          { "ar": "أَعُوْذُ", "bn": "আশ্রয় চাই" },
          { "ar": "بِكَ", "bn": "আপনার কাছে" },
          { "ar": "مِنَ", "bn": "থেকে / হতে" },
          { "ar": "ٱلْعَجْزِ،", "bn": "অক্ষমতা" },
          { "ar": "وَٱلْكَسَلِ،", "bn": "এবং অলসতা" },
          { "ar": "وَٱلْبُخْلِ،", "bn": "এবং কৃপণতা" },
          { "ar": "وَٱلْجُبْنِ،", "bn": "এবং কাপুরুষতা" },
          { "ar": "وَٱلْهَرَمِ،", "bn": "এবং অতি বার্ধক্য" },
          { "ar": "وَعَذَاْبِ", "bn": "এবং আযাব / শাস্তি" },
          { "ar": "ٱلْقَبْرِ.", "bn": "কবরের" }
        ]
      },
      {
        "id": 3,
        "text": "ٱللَّٰهُمَّ، آتِ نَفْسِيْ تَقْوَاْهَاْ، وَزَكِّهَاْ، أَنْتَ خَيْرُ مَنْ زَكَّاْهَاْ، أَنْتَ وَلِيُّهَاْ، وَمَوْلَاْهَاْ.",
        "translation": "হে আল্লাহ! আমার আত্মাকে (নফস) তার তাকওয়া (আল্লাহভীতি) দান করুন এবং তাকে পরিশুদ্ধ করুন, আপনিই তো সর্বোত্তম পরিশুদ্ধকারী; আপনিই তার অভিভাবক ও মালিক। (আন-নাসায়ী: ৫৫৩৭; মুসলিম: ২৭২২)",
        "words": [
          { "ar": "ٱللَّٰهُمَّ،", "bn": "হে আল্লাহ" },
          { "ar": "آتِ", "bn": "দান করুন" },
          { "ar": "نَفْسِيْ", "bn": "আমার আত্মাকে" },
          { "ar": "تَقْوَاْهَاْ،", "bn": "তার তাকওয়া (পরহেজগারি)" },
          { "ar": "وَزَكِّهَاْ،", "bn": "এবং তাকে পরিশুদ্ধ করুন" },
