{
  "id": "surah-al-fatihah",
  "type": "quran",
  "title": {
    "ar": "سورة الفاتحة",
    "bn": "সূরা ফাতিহা",
    "en": "Surah Al-Fatihah"
  },
  "content": {
    "items": [
      {
        "id": 1,
        "text": "",
        "translation": "আমি আল্লাহর কাছে বিতাড়িত শয়তান থেকে আশ্রয় চাই।",
        "showDivider": true,
        "words": [
          {
            "ar": "اَعُوْذُ",
            "bn": "আমি আশ্রয় চাই"
          },
          {
            "ar": "بِاللّٰهِ",
            "bn": "কাছে আল্লাহর"
          },
          {
            "ar": "مِنَ",
            "bn": "থেকে"
          },
          {
            "ar": "الشَّیْطٰنِ",
            "bn": "শয়তান"
          },
          {
            "ar": "الرَّجِیْمِ",
            "bn": "বিতাড়িত"
          },
          { "ar": "۝", "bn": "" }
        ]
      },
      {
        "id": 2,
        "text": "",
        "translation": "রহমান, রহীম আল্লাহ্‌র নামে",
        "showDivider": true,
        "words": [
          {
            "ar": "بِسْمِ",
            "bn": "নামে"
          },
          {
            "ar": "اللّٰهِ",
            "bn": "আল্লাহ (র)"
          },
          {
            "ar": "الرَّحْمٰنِ",
            "bn": "পরম করুণাময়"
          },
          {
            "ar": "الرَّحِیْمِ",
            "bn": "অসীম দয়ালু"
          },
          {
            "ar": "۟",
            "bn": ""
          }
        ]
      },
      {
        "id": 3,
        "text": "",
        "translation": "সকল ‘হাম্‌দ’ আল্লাহ্‌র, যিনি সৃষ্টিকুলের রব,",
        "showDivider": true,
        "words": [
          {
            "ar": "اَلْحَمْدُ",
            "bn": "সকল প্রশংসা"
          },
          {
            "ar": "لِلّٰهِ",
            "bn": "আল্লাহ্‌রই জন্য"
          },
          {
            "ar": "رَبِّ",
            "bn": "(যিনি) রব"
          },
          {
            "ar": "الْعٰلَمِیْنَ",
            "bn": "সারা জগতের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(২)"
          }
        ]
      },
      {
        "id": 4,
        "text": "",
        "translation": "দয়াময়, পরম দয়ালু,",
        "showDivider": true,
        "words": [
          {
            "ar": "الرَّحْمٰنِ",
            "bn": "অশেষ করুণাময়"
          },
          {
            "ar": "الرَّحِیْمِ",
            "bn": "পরম দয়ালু"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৩)"
          }
        ]
      },
      {
        "id": 5,
        "text": "",
        "translation": "বিচার দিনের মালিক।",
        "showDivider": true,
        "words": [
          {
            "ar": "مٰلِكِ",
            "bn": "অধিপতি"
          },
          {
            "ar": "یَوْمِ",
            "bn": "দিনের"
          },
          {
            "ar": "الدِّیْنِ",
            "bn": "বিচারের"
          },
          {
            "ar": "۟ؕ",
            "bn": "(৪)"
          }
        ]
      },
      {
        "id": 6,
        "text": "",
        "translation": "আমরা শুধু আপনারই ‘ইবাদাত করি, এবং শুধু আপনারই সাহায্য প্রার্থনা করি,",
        "showDivider": true,
        "words": [
          {
            "ar": "اِیَّاكَ",
            "bn": "আপনারই শুধু"
          },
          {
            "ar": "نَعْبُدُ",
            "bn": "আমরা ইবাদত করি"
          },
          {
            "ar": "وَاِیَّاكَ",
            "bn": "এবং আপনারই (কাছে শুধু)"
          },
          {
            "ar": "نَسْتَعِیْنُ",
            "bn": "আমরা সাহায্য চাই।"
          },
          {
            "ar": "۟ؕ",
            "bn": "(৫)"
          }
        ]
      },
      {
        "id": 7,
        "text": "",
        "translation": "আমাদেরকে সরল পথের হিদায়াত দিন",
        "showDivider": true,
        "words": [
          {
            "ar": "اِهْدِنَا",
            "bn": "আমাদেরকে দেখান"
          },
          {
            "ar": "الصِّرَاطَ",
            "bn": "পথ"
          },
          {
            "ar": "الْمُسْتَقِیْمَ",
            "bn": "সরল সঠিক"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৬)"
          }
        ]
      },
      {
        "id": 8,
        "text": "",
        "translation": "",
        "showDivider": false,
        "words": [
          {
            "ar": "صِرَاطَ",
            "bn": "(সেই) পথে"
          },
          {
            "ar": "الَّذِیْنَ",
            "bn": "যাদেরকে"
          },
          {
            "ar": "اَنْعَمْتَ",
            "bn": "আপনি অনুগ্রহ দান করেছেন"
          },
          {
            "ar": "عَلَیْهِمْ ۙ۬ۦ",
            "bn": "তাদের উপর"
          }
        ]
      },
      {
        "id": 9,
        "text": "",
        "translation": "তাদের পথ, যাদেরকে আপনি নি‘আমত দিয়েছেন, যাদের উপর আপনার ক্রোধ আপতিত হয়নি এবং যারা পথভ্রষ্টও নয়",
        "showDivider": true,
        "words": [
          {
            "ar": "غَیْرِ",
            "bn": "নয় (পথ)"
          },
          {
            "ar": "الْمَغْضُوْبِ",
            "bn": "অভিশপ্তদের"
          },
          {
            "ar": "عَلَیْهِمْ",
            "bn": "যাদের উপর (গজব পরেছে)"
          },
          {
            "ar": "وَلَا",
            "bn": "এবং না"
          },
          {
            "ar": "الضَّآلِّیْنَ",
            "bn": "পথভ্রষ্টদের"
          },
          {
            "ar": "۟۠",
            "bn": "(৭)"
          }
        ]
      },
      {
        "id": 8,
        "text": "",
        "translation": "",
        "showDivider": true,
        "words": [
          {
            "ar": "آمِيْنَ",
            "bn": "হে আল্লাহ, কবুল করুন।"
          }
        ]
      }
    ],
