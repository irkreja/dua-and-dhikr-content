  "content": {
    "items": [
      {
        "id": 1,
        "text": "",
        "translation": "রহমান, রহীম আল্লাহ্‌র নামে",
        "showDivider": true,
        "words": [
          {
            "ar": "بِسْمِ",
            "bn": "নামে"
          },
          {
            "ar": "اللّٰهِ",
            "bn": "আল্লাহ (র)"
          },
          {
            "ar": "الرَّحْمٰنِ",
            "bn": "পরম করুণাময়"
          },
          {
            "ar": "الرَّحِیْمِ",
            "bn": "অসীম দয়ালু"
          },
          {
            "ar": "۟",
            "bn": ""
          }
        ]
      },
      {
        "id": 2,
        "text": "",
        "translation": "বলুন, ‘আমি আশ্ৰয় প্রার্থনা করছি মানুষের রবের,",
        "showDivider": true,
        "words": [
          {
            "ar": "قُلْ",
            "bn": "বলো"
          },
          {
            "ar": "اَعُوْذُ",
            "bn": "\"আমি আশ্রয় চাই"
          },
          {
            "ar": "بِرَبِّ",
            "bn": "রবের নিকট"
          },
          {
            "ar": "النَّاسِ",
            "bn": "মানুষের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(১)"
          }
        ]
      },
      {
        "id": 3,
        "text": "",
        "translation": "মানুষের অধিপতির,",
        "showDivider": true,
        "words": [
          {
            "ar": "مَلِكِ",
            "bn": "মহা অধিপতির (নিকট)"
          },
          {
            "ar": "النَّاسِ",
            "bn": "মানুষের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(২)"
          }
        ]
      },
      {
        "id": 4,
        "text": "",
        "translation": "মানুষের ইলাহের কাছে",
        "showDivider": true,
        "words": [
          {
            "ar": "اِلٰهِ",
            "bn": "ইলাহ্‌র (নিকট)"
          },
          {
            "ar": "النَّاسِ",
            "bn": "মানুষের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৩)"
          }
        ]
      },
      {
        "id": 5,
        "text": "",
        "translation": "আত্মগোপনকারী কুমন্ত্রণাদাতার অনিষ্ট হতে,",
        "showDivider": true,
        "words": [
          {
            "ar": "مِنْ",
            "bn": "হতে"
          },
          {
            "ar": "شَرِّ",
            "bn": "অমঙ্গল"
          },
          {
            "ar": "الْوَسْوَاسِ ۙ۬",
            "bn": "কুমন্ত্রণার"
          },
          {
            "ar": "الْخَنَّاسِ",
            "bn": "আত্নগোপনকারী"
          },
          {
            "ar": "۟",
            "bn": "(৪)"
          }
        ]
      },
      {
        "id": 6,
        "text": "",
        "translation": "যে কুমন্ত্রণা দেয় মানুষের অন্তরে,",
        "showDivider": true,
        "words": [
          {
            "ar": "الَّذِیْ",
            "bn": "যে"
          },
          {
            "ar": "یُوَسْوِسُ",
            "bn": "কুমন্ত্রণা দেয়"
          },
          {
            "ar": "فِیْ",
            "bn": "মধ্যে"
          },
          {
            "ar": "صُدُوْرِ",
            "bn": "অন্তরসমূহের"
          },
          {
            "ar": "النَّاسِ",
            "bn": "মানুষের"
          },
          {
            "ar": "۟ۙ",
            "bn": "(৫)"
          }
        ]
      },
      {
        "id": 7,
        "text": "",
        "translation": "জিনের মধ্য থেকে এবং মানুষের মধ্য থেকে [১]।’",
        "showDivider": true,
        "words": [
          {
            "ar": "مِنَ",
            "bn": "মধ্য হতে"
          },
          {
            "ar": "الْجِنَّةِ",
            "bn": "জিনের"
          },
          {
            "ar": "وَالنَّاسِ",
            "bn": "ও মানুষের"
          },
          {
            "ar": "۟۠",
            "bn": "(৬)"
          }
        ]
      }
    ],
    "fullTranslation": "",
    "reference": "সুনানে আবু দাঊদ, হাদীস নং- ১৫২৩; বুখারী, হাদিস নং- ৫০১৭; তিরমিজী, হাদিস নং- ৩৫৭৫;"
  },
