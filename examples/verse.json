,"language_name":"english"}},{"id":25871,"position":17,"audio_url":"wbw/059_023_018.mp3","char_type_name":"word","text_indopak_nastaleeq":"اللّٰهِ","text_uthmani":"ٱللَّهِ","text_qpc_hafs":"ٱللَّهِ","code_v2":"ﲮ","verse_key":"59:23","page_number":548,"line_number":12,"text":"ﲮ","translation":{"text":"আল্লাহ (র)","language_name":"bengali"},"transliteration":{"text":"l-lahi","language_name":"english"}},{"id":25872,"position":18,"audio_url":"wbw/059_023_019.mp3","char_type_name":"word","text_indopak_nastaleeq":"عَمَّا","text_uthmani":"عَمَّا","text_qpc_hafs":"عَمَّا","code_v2":"ﲯ","verse_key":"59:23","page_number":548,"line_number":12,"text":"ﲯ","translation":{"text":"যা হতে","language_name":"bengali"},"transliteration":{"text":"ʿammā","language_name":"english"}},{"id":25873,"position":19,"audio_url":"wbw/059_023_020.mp3","char_type_name":"word","text_indopak_nastaleeq":"یُشْرِكُوْنَ","text_uthmani":"يُشْرِكُونَ","text_qpc_hafs":"يُشۡرِكُونَ","code_v2":"ﲰ","verse_key":"59:23","page_number":548,"line_number":12,"text":"ﲰ","translation":{"text":"তারা শরীক করে","language_name":"bengali"},"transliteration":{"text":"yush'rikūna","language_name":"english"}},{"id":25874,"position":20,"audio_url":null,"char_type_name":"end","text_indopak_nastaleeq":"۟","text_uthmani":"٢٣","text_qpc_hafs":"٢٣","code_v2":"ﲱ","verse_key":"59:23","page_number":548,"line_number":12,"text":"ﲱ","translation":{"text":"(২৩)","language_name":"bengali"},"transliteration":{"text":null,"language_name":"english"}}],"translations":[{"id":327784,"resource_id":57,"text":"Huwa Allahu allathee lailaha illa huwa almaliku alquddoosu assalamualmu/minu almuhayminu alAAazeezu aljabbaru almutakabbirusubhana Allahi AAamma yushrikoon","language_name":"english","verse_key":"59:23","resource_name":"Transliteration","language_id":38},{"id":1096126,"resource_id":161,"text":"তিনিই আল্লাহ যিনি ছাড়া সত্যিকারের কোন ইলাহ নেই, তিনিই বাদশাহ, অতি পবিত্র, পূর্ণ শান্তিময়, নিরাপত্তা দানকারী, প্রতাপশালী, পর্যবেক্ষক, মহা পরাক্রমশালী, অপ্রতিরোধ্য, প্রকৃত গর্বের অধিকারী। তারা যাকে (তাঁর) শরীক করে তাত্থেকে তিনি পবিত্র, মহান।","language_name":"bengali","verse_key":"59:23","resource_name":"Taisirul Quran","language_id":20},{"id":1108598,"resource_id":163,"text":"তিনিই আল্লাহ, তিনি ব্যতীত কোন মা‘বূদ নেই। তিনিই অধিপতি, তিনিই পবিত্র, তিনিই শান্তি, তিনিই নিরাপত্তা বিধায়ক, তিনিই রক্ষক, তিনিই পরাক্রমশালী, তিনিই প্রবল, তিনিই অতীব মহিমান্বিত; যারা তাঁর শরীক স্থির করে আল্লাহ তা হতে পবিত্র ও মহান।","language_name":"bengali","verse_key":"59:23","resource_name":"Sheikh Mujibur Rahman","language_id":20},{"id":1102362,"resource_id":162,"text":"তিনিই আল্লাহ; যিনি ছাড়া কোন ইলাহ নেই, তিনিই বাদশাহ, মহাপবিত্র, ত্রুটিমুক্ত, নিরাপত্তাদানকারী, রক্ষক, মহাপরাক্রমশালী, মহাপ্রতাপশালী, অতীব মহিমান্বিত, তারা যা শরীক করে তা হতে পবিত্র মহান।","language_name":"bengali","verse_key":"59:23","resource_name":"Rawai Al-bayan","language_id":20},{"id":1171745,"resource_id":213,"text":"তিনি আল্লাহ্‌, তিনি ছাড়া কোনো সত্য ইলাহ নেই। তিনিই অধিপতি, মহাপবিত্র <sup foot_note=350098>1</sup>, ক্রটিমুক্ত, নিরাপত্তা বিধায়ক, রক্ষক, পরাক্রমশালী, প্রবল, অতীব মহিমান্বিত। তারা যা শরীক স্থির করে আল্লাহ্‌ তা হতে পবিত্র, মহান।","language_name":"bengali","verse_key":"59:23","resource_name":"Dr. Abu Bakr Muhammad Zakaria","language_id":20}]},{"id":5150,"verse_number":24,"verse_key":"59:24","hizb_number":55,"rub_el_hizb_number":219,"ruku_number":483,"manzil_number":7,"sajdah_number":null,"text_indopak_nastaleeq":"هُوَ اللّٰهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْاَسْمَآءُ الْحُسْنٰی ؕ یُسَبِّحُ لَهٗ مَا فِی السَّمٰوٰتِ وَالْاَرْضِ ۚ وَهُوَ الْعَزِیْزُ الْحَكِیْمُ ۟۠","text_uthmani":"هُوَ ٱللَّهُ ٱلْخَـٰلِقُ ٱلْبَارِئُ ٱلْمُصَوِّرُ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ ۚ يُسَبِّحُ لَهُۥ مَا فِى ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ","text_qpc_hafs":"هُوَ ٱللَّهُ ٱلۡخَٰلِقُ ٱلۡبَارِئُ ٱلۡمُصَوِّرُۖ لَهُ ٱلۡأَسۡمَآءُ ٱلۡحُسۡنَىٰۚ يُسَبِّحُ لَهُۥ مَا فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۖ وَهُوَ ٱلۡعَزِيزُ ٱلۡحَكِيمُ ٢٤","code_v2":"ﲲ ﲳ ﲴ ﲵ ﲶ ﲷ ﲸ ﲹ ﲺ