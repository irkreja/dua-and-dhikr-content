on":{"text":"পরাক্রমশালী,","language_name":"bengali"},"transliteration":{"text":"l-ʿazīzu","language_name":"english"}},{"id":26970,"position":17,"audio_url":"wbw/059_024_020.mp3","char_type_name":"word","text_indopak_nastaleeq":"الْحَكِیْمُ","text_uthmani":"ٱلْحَكِيمُ","text_qpc_hafs":"ٱلۡحَكِيمُ","code_v2":"ﳅ","verse_key":"59:24","page_number":548,"line_number":14,"text":"ﳅ","translation":{"text":"মহাবিজ্ঞ","language_name":"bengali"},"transliteration":{"text":"l-ḥakīmu","language_name":"english"}},{"id":26971,"position":18,"audio_url":null,"char_type_name":"end","text_indopak_nastaleeq":"۟۠","text_uthmani":"٢٤","text_qpc_hafs":"٢٤","code_v2":"ﳆ","verse_key":"59:24","page_number":548,"line_number":14,"text":"ﳆ","translation":{"text":"(২৪)","language_name":"bengali"},"transliteration":{"text":null,"language_name":"english"}}],"translations":[{"id":327786,"resource_id":57,"text":"Huwa Allahu alkhaliqu albari-oalmusawwiru lahu al-asmao alhusnayusabbihu lahu ma fee assamawatiwal-ardi wahuwa alAAazeezu alhakeem","language_name":"english","verse_key":"59:24","resource_name":"Transliteration","language_id":38},{"id":1096127,"resource_id":161,"text":"তিনিই আল্লাহ সৃষ্টিকারী, উদ্ভাবনকারী, আকার আকৃতি প্রদানকারী। সমস্ত উত্তম নামের অধিকারী। আসমান ও যমীনে যা আছে সবই তাঁর গৌরব ও মহিমা ঘোষণা করে। তিনি প্রবল পরাক্রান্ত মহা প্রজ্ঞাবান।","language_name":"bengali","verse_key":"59:24","resource_name":"Taisirul Quran","language_id":20},{"id":1108599,"resource_id":163,"text":"তিনিই আল্লাহ, সৃজনকর্তা, উদ্ভাবক, রূপদাতা, সকল উত্তম নাম তাঁরই। আকাশ ও পৃথিবীতে যা কিছু আছে সমস্তই তাঁর পবিত্রতা ও মহিমা ঘোষণা করে। তিনি পরাক্রমশালী, প্রজ্ঞাময়।","language_name":"bengali","verse_key":"59:24","resource_name":"Sheikh Mujibur Rahman","language_id":20},{"id":1102363,"resource_id":162,"text":"তিনিই আল্লাহ, স্রষ্টা, উদ্ভাবনকর্তা, আকৃতিদানকারী; তাঁর রয়েছে সুন্দর নামসমূহ; আসমান ও যমীনে যা আছে সবই তার মহিমা ঘোষণা করে। তিনি মহাপরাক্রমশালী, প্রজ্ঞাময়।","language_name":"bengali","verse_key":"59:24","resource_name":"Rawai Al-bayan","language_id":20},{"id":1171746,"resource_id":213,"text":"তিনিই আল্লাহ সৃজনকর্তা, উদ্ভাবন কর্তা, তাঁরই সকল উত্তম নাম <sup foot_note=350099>1</sup>। আসমানসমূহ ও যমীনে যা কিছু আছে, সবকিছুই  তাঁর পবিত্রতা ও মহিমা ঘোষণা করে। তিনি পরক্রমশালী, প্রজ্ঞাময়।","language_name":"bengali","verse_key":"59:24","resource_name":"Dr. Abu Bakr Muhammad Zakaria","language_id":20}]}],"pagination":{"per_page":10,"current_page":1,"next_page":null,"total_pages":1,"total_records":3}}
